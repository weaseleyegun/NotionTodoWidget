<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <!-- 입력칸 + 보내기 아이콘 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <EditText
            android:id="@+id/quick_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:inputType="textCapSentences"
            android:imeOptions="actionSend"
            android:maxLines="1"
            android:singleLine="true" />
        <ImageButton
            android:id="@+id/quick_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_send"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- 마감일 (선택) -->
    <RadioGroup
        android:id="@+id/quick_due"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton
            android:id="@+id/quick_due_none"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:textSize="13sp"
            android:checked="true" />
        <RadioButton
            android:id="@+id/quick_due_today"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:textSize="13sp" />
        <RadioButton
            android:id="@+id/quick_due_tomorrow"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:textSize="13sp" />
    </RadioGroup>

    <TextView
        android:id="@+id/quick_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textSize="13sp"
        android:textColor="@color/widget_due_over"
        android:paddingBottom="4dp" />
</LinearLayout>
