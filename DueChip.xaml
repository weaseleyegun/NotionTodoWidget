<UserControl x:Class="NotionTodoWidget.DueChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left">
    <Grid>
        <!-- 칩: 선택된 날짜(또는 '마감일 없음')를 보여주고, 누르면 달력이 열립니다 -->
        <Button x:Name="ChipBtn" Style="{StaticResource ChipButton}" Click="Chip_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                           VerticalAlignment="Center" Margin="0,1,7,0" />
                <TextBlock x:Name="ChipText" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=ChipBtn}" Placement="Bottom"
               VerticalOffset="4" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="10" Width="246">
                <StackPanel>
                    <!-- 월 이동 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource IconButton}"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE76B;" FontSize="11"
                                Width="26" Height="26" Click="Prev_Click" />
                        <TextBlock x:Name="MonthText" Grid.Column="1" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE76C;" FontSize="11"
                                Width="26" Height="26" Click="Next_Click" />
                    </Grid>

                    <UniformGrid x:Name="WeekRow" Columns="7" />
                    <UniformGrid x:Name="DayGrid" Columns="7" Rows="6" Margin="0,2,0,0" />

                    <Border Height="1" Background="{DynamicResource PopupBorderBrush}" Margin="0,8,0,8" />
                    <WrapPanel x:Name="QuickRow" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
