<Window x:Class="NotionTodoWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NotionTodoWidget"
        Title="{x:Static local:Strings.SettingsTitle}"
        Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Malgun Gothic"
        SourceInitialized="Window_SourceInitialized">

    <StackPanel Margin="22,18,22,20">

        <TextBlock Text="{x:Static local:Strings.SetupIntro}" TextWrapping="Wrap" FontSize="12.5" LineHeight="20"
                   Foreground="{DynamicResource SubTextBrush}" />
        <TextBlock Margin="0,8,0,16" FontSize="12.5">
            <Hyperlink Click="Integrations_Click" Foreground="{DynamicResource AccentBrush}">
                <Run Text="{x:Static local:Strings.OpenIntegrations}" />
            </Hyperlink>
        </TextBlock>

        <TextBlock Text="{x:Static local:Strings.TokenLabel}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
        <PasswordBox x:Name="TokenBox" FontSize="13" Padding="8,6"
                     Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                     CaretBrush="{DynamicResource TextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" />

        <TextBlock Text="{x:Static local:Strings.DbLabel}" FontSize="12" FontWeight="SemiBold" Margin="0,14,0,4" />
        <TextBox x:Name="DbBox" Style="{StaticResource InputBox}" />
        <TextBlock Text="{x:Static local:Strings.DbHint}" TextWrapping="Wrap" FontSize="11.5" Margin="0,5,0,0"
                   Foreground="{DynamicResource MutedBrush}" />

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static local:Strings.RefreshLabel}" FontSize="12.5" VerticalAlignment="Center" />
            <TextBox x:Name="RefreshBox" Grid.Column="1" Style="{StaticResource InputBox}" Width="70"
                     HorizontalContentAlignment="Center" />
        </Grid>

        <CheckBox x:Name="OpenInAppCheck" Style="{StaticResource LabelCheck}" Margin="0,14,0,0"
                  Content="{x:Static local:Strings.OpenInApp}" />
        <CheckBox x:Name="AutoStartCheck" Style="{StaticResource LabelCheck}" Margin="0,10,0,0"
                  Content="{x:Static local:Strings.MenuAutoStart}" />

        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
            <TextBlock Text="{x:Static local:Strings.LanguageLabel}" FontSize="12.5" VerticalAlignment="Center"
                       Margin="0,0,12,0" />
            <RadioButton x:Name="LangAuto" Style="{StaticResource PillRadio}" GroupName="Lang" Tag="auto"
                         Content="{x:Static local:Strings.LanguageAuto}" />
            <RadioButton x:Name="LangKo" Style="{StaticResource PillRadio}" GroupName="Lang" Tag="ko" Content="한국어" />
            <RadioButton x:Name="LangEn" Style="{StaticResource PillRadio}" GroupName="Lang" Tag="en" Content="English" />
        </StackPanel>
        <TextBlock Text="{x:Static local:Strings.LanguageNote}" FontSize="11.5" Margin="0,5,0,0"
                   Foreground="{DynamicResource MutedBrush}" />

        <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="12.5" Margin="0,16,0,0" MinHeight="18" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="TestBtn" Style="{StaticResource ChipButton}" Padding="14,6" Margin="0,0,8,0"
                    Content="{x:Static local:Strings.BtnTest}" Click="Test_Click" />
            <Button Style="{StaticResource ChipButton}" Padding="14,6" Margin="0,0,8,0" IsCancel="True"
                    Content="{x:Static local:Strings.BtnCancel}" />
            <Button Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Content="{x:Static local:Strings.BtnSave}" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
