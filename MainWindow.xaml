<Window x:Class="NotionTodoWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NotionTodoWidget"
        Title="Todo Widget"
        Width="360" Height="640" MinWidth="320" MinHeight="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI, Malgun Gothic"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Activated="Window_Activated">

    <Window.Resources>

        <!-- 카드 -->
        <DataTemplate x:Key="TodoTemplate">
            <Border x:Name="Card" Margin="0,0,0,8" Padding="12,10,8,10"
                    CornerRadius="8" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,1,1,2"
                    Cursor="Hand" MouseLeftButtonUp="Card_MouseLeftButtonUp">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{x:Static local:Strings.MenuToggle}" Click="CardToggle_Click" />
                        <MenuItem Header="{x:Static local:Strings.MenuOpenInNotion}" Click="OpenNotion_Click" />
                        <Separator />
                        <MenuItem Header="{x:Static local:Strings.MenuDelete}" Click="CardDelete_Click" />
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 아이콘(이모지) + 제목 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                               FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,3,8,8">
                        <Run Text="{Binding IconPrefix, Mode=OneWay}" FontFamily="Segoe UI Emoji" />
                        <Run Text="{Binding Title, Mode=OneWay}" />
                    </TextBlock>

                    <!-- 이 항목의 노션 페이지 열기 -->
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource IconButton}"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE8A7;" FontSize="12"
                            Width="24" Height="24" ToolTip="{x:Static local:Strings.TipOpenItem}" Click="OpenNotion_Click" />

                    <!-- 체크박스 -->
                    <CheckBox Grid.Row="1" Grid.Column="0" Style="{StaticResource NotionCheck}"
                              VerticalAlignment="Top" Margin="0,0,10,0"
                              Click="Done_Click" ToolTip="{x:Static local:Strings.TipDone}" />

                    <!-- 세부내용: 접힘 = 한 줄 미리보기 / 펼침 = 편집창 -->
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,6,0">
                        <TextBlock x:Name="DetailText" Text="{Binding DetailPreview}" FontSize="12.5"
                                   Foreground="{DynamicResource SubTextBrush}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />

                        <Grid x:Name="EditorHost" Visibility="Collapsed">
                            <TextBox x:Name="DetailEditor" Text="{Binding Detail, Mode=OneWay}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="180"
                                     VerticalScrollBarVisibility="Auto" FontSize="12.5"
                                     Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                     Background="{DynamicResource EditorBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                     Padding="6,4" Cursor="IBeam"
                                     ToolTip="{x:Static local:Strings.EditorTip}"
                                     LostFocus="DetailEditor_LostFocus"
                                     PreviewKeyDown="DetailEditor_PreviewKeyDown" />
                            <TextBlock Text="{x:Static local:Strings.EditorPlaceholder}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                                       IsHitTestVisible="False" Margin="10,5,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=DetailEditor}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <!-- 펼치기 / 접기 버튼 -->
                    <Button x:Name="ExpandBtn" Grid.Row="1" Grid.Column="2" Style="{StaticResource IconButton}"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE70D;" FontSize="11"
                            Width="24" Height="24" VerticalAlignment="Top" Margin="0,-3,0,0"
                            ToolTip="{x:Static local:Strings.TipExpand}" Click="Expand_Click" />

                    <!-- 마감 태그 + 생성일 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                Orientation="Horizontal" Margin="0,9,0,0">
                        <local:DueChip x:Name="DueEditor" Visibility="Collapsed" Margin="0,0,8,0"
                                       Value="{Binding Due, Mode=OneWay}" DateChanged="CardDue_Changed" />
                        <Border x:Name="DueTag" CornerRadius="4" Padding="6,1,6,2" Background="{DynamicResource TagBg}"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="DueLabel" Text="{Binding DueText}" FontFamily="Consolas, Malgun Gothic"
                                       FontSize="11.5" Foreground="{DynamicResource TagFg}" />
                        </Border>
                        <TextBlock Text="{Binding CreatedText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                </Trigger>

                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="DetailText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="EditorHost" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ExpandBtn" Property="Content" Value="&#xE70E;" />
                    <Setter TargetName="DueEditor" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasDetail}" Value="False">
                    <Setter TargetName="DetailText" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                </DataTrigger>

                <!-- 마감 태그 색상 (노션 태그 톤) -->
                <DataTrigger Binding="{Binding DueKind}" Value="none">
                    <Setter TargetName="DueTag" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DueKind}" Value="ok">
                    <Setter TargetName="DueTag" Property="Background" Value="{DynamicResource TagOkBg}" />
                    <Setter TargetName="DueLabel" Property="Foreground" Value="{DynamicResource TagOkFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DueKind}" Value="today">
                    <Setter TargetName="DueTag" Property="Background" Value="{DynamicResource TagTodayBg}" />
                    <Setter TargetName="DueLabel" Property="Foreground" Value="{DynamicResource TagTodayFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DueKind}" Value="over">
                    <Setter TargetName="DueTag" Property="Background" Value="{DynamicResource TagOverBg}" />
                    <Setter TargetName="DueLabel" Property="Foreground" Value="{DynamicResource TagOverFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                CornerRadius="14">
            <Grid Margin="14,12,14,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 헤더: 드래그로 이동, 우클릭 메뉴 -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="AutoStartMenu" Header="{x:Static local:Strings.MenuAutoStart}"
                                      IsCheckable="True" Click="AutoStart_Click" />
                            <Separator />
                            <MenuItem Header="{x:Static local:Strings.MenuExpandAll}" Click="ExpandAll_Click" />
                            <MenuItem Header="{x:Static local:Strings.MenuRefresh}" Click="Refresh_Click" />
                            <MenuItem Header="{x:Static local:Strings.MenuSettings}" Click="Settings_Click" />
                            <Separator />
                            <MenuItem Header="{x:Static local:Strings.MenuClose}" Click="Close_Click" />
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- DB 제목은 노션에서 가져옵니다 -->
                    <Border Grid.Column="0" Background="{DynamicResource TitlePillBrush}" CornerRadius="5" Padding="9,2,9,3"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,8,0">
                        <DockPanel>
                            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Text="0" FontSize="14"
                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="9,0,0,0" />
                            <TextBlock x:Name="HeaderTitle" Text="{x:Static local:Strings.HeaderFallback}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="OpenDbBtn" Style="{StaticResource IconButton}"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE8A7;" FontSize="13"
                                Width="28" Height="28" ToolTip="{x:Static local:Strings.TipOpenDb}" Click="OpenDatabase_Click" />
                        <Button x:Name="ExpandAllBtn" Style="{StaticResource IconButton}"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE70D;" FontSize="12"
                                Width="28" Height="28" ToolTip="{x:Static local:Strings.TipExpandAll}" Click="ExpandAll_Click" />
                        <Button x:Name="PinButton" Style="{StaticResource IconButton}"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE718;" FontSize="13"
                                Width="28" Height="28" ToolTip="{x:Static local:Strings.TipPin}" Click="Pin_Click" />
                        <Button Style="{StaticResource IconButton}"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE72C;" FontSize="13"
                                Width="28" Height="28" ToolTip="{x:Static local:Strings.TipRefresh}" Click="Refresh_Click" />
                        <Button Style="{StaticResource IconButton}"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE711;" FontSize="12"
                                Width="28" Height="28" ToolTip="{x:Static local:Strings.TipClose}" Click="Close_Click" />
                    </StackPanel>
                </Grid>

                <!-- 상태줄: Notion 연결 상태 + 테마 전환 + 투명도 -->
                <Grid Grid.Row="1" Margin="0,8,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="StatusPill" Background="{DynamicResource PillBrush}" CornerRadius="10"
                            Padding="9,3" HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,8,0"
                            MouseLeftButtonUp="StatusPill_MouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StatusDot" Text="●" FontSize="10" Foreground="#94A3B8"
                                       VerticalAlignment="Center" Margin="0,1,6,0" />
                            <TextBlock x:Name="StatusLabel" Text="{x:Static local:Strings.ConnChecking}" FontSize="11.5"
                                       Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ThemeBtn" Style="{StaticResource IconButton}"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE708;" FontSize="13"
                                Width="26" Height="26" Margin="0,0,6,0" Click="ThemeToggle_Click" />
                        <StackPanel Orientation="Horizontal" ToolTip="{x:Static local:Strings.TipOpacity}">
                            <TextBlock Text="◐" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,0,5,1"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1" Width="72"
                                    VerticalAlignment="Center" SmallChange="0.05" LargeChange="0.1"
                                    ValueChanged="OpacitySlider_ValueChanged"
                                    PreviewMouseLeftButtonUp="OpacitySlider_PreviewMouseLeftButtonUp" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 설정/오류 메시지 -->
                <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="{DynamicResource ErrorBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="2,0,2,8" Visibility="Collapsed" />

                <!-- 카드 목록 (세로 스크롤) -->
                <Grid Grid.Row="3">
                    <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl x:Name="TodoList" ItemTemplate="{StaticResource TodoTemplate}" />
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyText" Visibility="Collapsed" IsHitTestVisible="False"
                               Text="{x:Static local:Strings.EmptyText}"
                               TextAlignment="Center" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="22" />
                </Grid>

                <!-- 실행 취소 알림 -->
                <Border x:Name="UndoBar" Grid.Row="4" Visibility="Collapsed" Background="{DynamicResource UndoBgBrush}"
                        CornerRadius="8" Padding="12,4,6,4" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="UndoText" Foreground="{DynamicResource UndoTextBrush}" FontSize="12.5"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Content="{x:Static local:Strings.UndoAction}" Style="{StaticResource IconButton}"
                                Foreground="{DynamicResource UndoActionBrush}" FontSize="12.5" FontWeight="SemiBold" Padding="8,3"
                                Click="Undo_Click" />
                    </Grid>
                </Border>

                <!-- 새 할 일 추가 -->
                <StackPanel Grid.Row="5" Margin="0,10,0,0">
                    <!-- 세부내용 / 마감일 (▾ 로 펼침) -->
                    <Border x:Name="NewDetailPanel" Visibility="Collapsed" Margin="0,0,0,8" Padding="8,6"
                            CornerRadius="8" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,1,1,2">
                        <StackPanel>
                            <Grid>
                                <TextBox x:Name="NewDetailBox" MinHeight="54" MaxHeight="110" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12.5"
                                         Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}" BorderThickness="0"
                                         Background="Transparent" PreviewKeyDown="NewDetailBox_PreviewKeyDown" />
                                <TextBlock Text="{x:Static local:Strings.NewDetailPlaceholder}" FontSize="12.5"
                                           Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" Margin="5,1,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NewDetailBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <local:DueChip x:Name="NewDueChip" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Border CornerRadius="8" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,1,1,2" />
                        <TextBox x:Name="AddBox" Height="36" FontSize="13" Padding="12,0,36,0"
                                 VerticalContentAlignment="Center" Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}" BorderThickness="0"
                                 PreviewKeyDown="AddBox_PreviewKeyDown" />
                        <TextBlock Text="{x:Static local:Strings.AddPlaceholder}" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=AddBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button x:Name="ToggleDetailBtn" Style="{StaticResource IconButton}"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE70D;" FontSize="11"
                                Width="28" Height="28" HorizontalAlignment="Right" Margin="0,0,4,1"
                                ToolTip="{x:Static local:Strings.TipToggleDetail}" Click="ToggleDetail_Click" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 크기 조절 손잡이 (오른쪽 아래) -->
        <Thumb HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="16" Height="16"
               Margin="0,0,3,3" Cursor="SizeNWSE" ToolTip="{x:Static local:Strings.TipResize}"
               DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <TextBlock Text="◢" FontSize="11" Foreground="{DynamicResource ThumbBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
